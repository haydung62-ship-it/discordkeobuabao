const healthServer = http.createServer((request, response) => {
  response.setHeader('Content-Type', 'application/json; charset=utf-8');

  // Liveness: Railway chỉ cần biết tiến trình HTTP đang hoạt động.
  // Luôn trả 200 để quá trình đăng nhập Discord chậm không làm hỏng deployment.
  if (request.url === '/health') {
    response.statusCode = 200;
    response.end(
      JSON.stringify({
        status: 'ok',
        discord: botReady ? 'connected' : 'connecting',
        uptimeSeconds: Math.floor((Date.now() - startedAt) / 1000),
      }),
    );
    return;
  }

  // Readiness riêng: dùng khi cần kiểm tra bot đã kết nối Discord hay chưa.
  if (request.url === '/ready') {
    response.statusCode = botReady ? 200 : 503;
    response.end(
      JSON.stringify({
        status: botReady ? 'ready' : 'not-ready',
        discord: botReady ? 'connected' : 'connecting',
      }),
    );
    return;
  }

  response.statusCode = 200;
  response.end(
    JSON.stringify({
      name: 'Discord Game Bot',
      status: botReady ? 'online' : 'starting',
      health: '/health',
    }),
  );
});

function guildKey(interaction) {
  return interaction.guildId || 'direct-messages';
}

function guessKey(interaction) {
  return `${guildKey(interaction)}:${interaction.user.id}`;
}

function playerGameKey(guildId, userId) {
  return `${guildId || 'direct-messages'}:${userId}`;
}

function levelFromXp(xp) {
  return Math.floor(Math.sqrt(Math.max(0, xp) / 100)) + 1;
}

async function registerCommands() {
  if (!AUTO_REGISTER) {
    console.log('[COMMANDS] Bỏ qua đăng ký lệnh vì AUTO_REGISTER_COMMANDS=false.');
    return;
  }

  const rest = new REST({ version: '10' }).setToken(TOKEN);
  const route = GUILD_ID
    ? Routes.applicationGuildCommands(CLIENT_ID, GUILD_ID)
    : Routes.applicationCommands(CLIENT_ID);

  console.log(
    `[COMMANDS] Đang đăng ký ${commandData.length} lệnh ${
      GUILD_ID ? `cho server ${GUILD_ID}` : 'toàn cục'
    }...`,
  );

  await rest.put(route, { body: commandData });
  console.log('[COMMANDS] Đăng ký lệnh thành công.');
}

function helpEmbed() {
  return new EmbedBuilder()
    .setTitle('🎮 Trung tâm trò chơi')
    .setDescription('Dùng các lệnh slash bên dưới để bắt đầu chơi.')
    .addFields(
      { name: '/rps', value: 'Kéo – búa – bao với bot.', inline: true },
      { name: '/guess start', value: 'Bắt đầu trò đoán số.', inline: true },
      { name: '/quiz', value: 'Câu hỏi trắc nghiệm.', inline: true },
      { name: '/dice', value: 'Tung từ 1 đến 10 viên xúc xắc.', inline: true },
      { name: '/caro', value: 'Thách đấu caro 3×3 với thành viên khác.', inline: true },
      { name: '/profile', value: 'Xem XP, xu và thành tích.', inline: true },
      { name: '/top', value: 'Bảng xếp hạng XP trong server.', inline: true },
      { name: '/ping', value: 'Kiểm tra độ trễ và trạng thái bot.', inline: true },
    )
    .setFooter({ text: 'Chơi vui vẻ và tôn trọng mọi người!' });
}

async function ephemeral(interaction, content) {
  const payload = { content, flags: MessageFlags.Ephemeral };
  if (interaction.replied || interaction.deferred) {
    return interaction.followUp(payload);
  }
  return interaction.reply(payload);
}

async function handleRps(interaction) {
  const selected = interaction.options.getString('chon', true);
  const choices = ['keo', 'bua', 'bao'];
  const botChoice = choices[Math.floor(Math.random() * choices.length)];
  const icons = { keo: '✂️ Kéo', bua: '🪨 Búa', bao: '📄 Bao' };
  const beats = { keo: 'bao', bao: 'bua', bua: 'keo' };

  let result;
  let reward;
  if (selected === botChoice) {
    result = '🤝 Hòa!';
    reward = { xp: 5, coins: 2, games: 1 };
  } else if (beats[selected] === botChoice) {
    result = '🏆 Bạn thắng!';
    reward = { xp: 20, coins: 12, games: 1, wins: 1 };
  } else {
    result = '🤖 Bot thắng!';
    reward = { xp: 3, games: 1 };
  }

  await addReward(guildKey(interaction), interaction.user.id, reward);

  const embed = new EmbedBuilder()
    .setTitle('Kéo – Búa – Bao')
    .addFields(
      { name: 'Bạn chọn', value: icons[selected], inline: true },
      { name: 'Bot chọn', value: icons[botChoice], inline: true },
      { name: 'Kết quả', value: result, inline: false },
    )
    .setFooter({
      text: reward.coins
        ? `Nhận ${reward.xp} XP và ${reward.coins} xu`
        : `Nhận ${reward.xp} XP`,
    });

  await interaction.reply({ embeds: [embed] });
}

async function handleGuess(interaction) {
  const subcommand = interaction.options.getSubcommand();
  const key = guessKey(interaction);

  if (subcommand === 'start') {
    const difficulty = interaction.options.getString('do_kho', true);
    const config = difficultyConfig[difficulty];
    const target = Math.floor(Math.random() * config.max) + 1;

    guessSessions.set(key, {
      target,
      difficulty,
      attempts: 0,
      startedAt: Date.now(),
    });

    await interaction.reply(
      `🔢 Đã bắt đầu mức **${config.label}**. Tôi đã chọn một số từ **1 đến ${config.max}**. Dùng \`/guess try\` để đoán!`,
    );
    return;
  }

  const session = guessSessions.get(key);
  if (!session) {
    await ephemeral(interaction, 'Bạn chưa có ván đoán số. Hãy dùng `/guess start` trước.');
    return;
  }

  if (subcommand === 'stop') {
    guessSessions.delete(key);
    await addReward(guildKey(interaction), interaction.user.id, { games: 1 });
    await interaction.reply(`🛑 Đã dừng ván. Số đúng là **${session.target}**.`);
    return;
  }

  const number = interaction.options.getInteger('so', true);
  const config = difficultyConfig[session.difficulty];

  if (number > config.max) {
    await ephemeral(interaction, `Mức này chỉ nhận số từ 1 đến ${config.max}.`);
    return;
  }

  session.attempts += 1;

  if (number === session.target) {
    guessSessions.delete(key);
    const xp = Math.max(10, config.xp - (session.attempts - 1) * 2);
    const coins = Math.max(5, config.coins - Math.floor((session.attempts - 1) / 2));
    await addReward(guildKey(interaction), interaction.user.id, {
      xp,
      coins,
      games: 1,
      wins: 1,
    });

    await interaction.reply(
      `🎉 Chính xác! Số cần tìm là **${session.target}**. Bạn đoán đúng sau **${session.attempts}** lần và nhận **${xp} XP + ${coins} xu**.`,
    );
    return;
  }

  const hint = number < session.target ? 'lớn hơn' : 'nhỏ hơn';
  await interaction.reply(
    `❌ Chưa đúng. Số cần tìm **${hint} ${number}**. Đây là lần đoán thứ **${session.attempts}**.`,
  );
}

function buildQuizRow(questionIndex, ownerId, disabled = false) {
  const question = quizQuestions[questionIndex];
  const letters = ['A', 'B', 'C', 'D'];
  const row = new ActionRowBuilder();

  question.choices.forEach((_, choiceIndex) => {
    row.addComponents(
      new ButtonBuilder()
        .setCustomId(`quiz:${questionIndex}:${choiceIndex}:${ownerId}`)
        .setLabel(letters[choiceIndex])
        .setStyle(ButtonStyle.Primary)
        .setDisabled(disabled),
    );
  });

  return row;
}

async function handleQuizCommand(interaction) {
  const questionIndex = Math.floor(Math.random() * quizQuestions.length);
  const question = quizQuestions[questionIndex];
  const letters = ['A', 'B', 'C', 'D'];

  const embed = new EmbedBuilder()
    .setTitle('🧠 Câu hỏi trắc nghiệm')
    .setDescription(question.question)
    .addFields(
      question.choices.map((choice, index) => ({
        name: `${letters[index]}.`,
        value: choice,
        inline: true,
      })),
    )
    .setFooter({ text: 'Chọn một đáp án bằng nút bên dưới.' });

  await interaction.reply({
    embeds: [embed],
    components: [buildQuizRow(questionIndex, interaction.user.id)],
  });
}

async function handleQuizButton(interaction, parts) {
  const questionIndex = Number(parts[1]);
  const selectedIndex = Number(parts[2]);
  const ownerId = parts[3];
  const question = quizQuestions[questionIndex];

  if (!question || !Number.isInteger(selectedIndex)) {
    await ephemeral(interaction, 'Câu hỏi này không còn hợp lệ.');
    return;
  }

  if (interaction.user.id !== ownerId) {
    await ephemeral(interaction, 'Chỉ người mở câu hỏi mới được trả lời.');
    return;
  }

  const correct = selectedIndex === question.answer;
  const reward = correct
    ? { xp: 25, coins: 15, games: 1, wins: 1, quizCorrect: 1 }
    : { xp: 3, games: 1 };

  await addReward(guildKey(interaction), interaction.user.id, reward);

  const embed = new EmbedBuilder()
    .setTitle(correct ? '✅ Chính xác!' : '❌ Chưa chính xác')
    .setDescription(question.question)
    .addFields(
      {
        name: 'Đáp án đúng',
        value: question.choices[question.answer],
      },
      {
        name: 'Phần thưởng',
        value: correct ? '+25 XP, +15 xu' : '+3 XP',
      },
    );

  await interaction.update({
    embeds: [embed],
    components: [buildQuizRow(questionIndex, ownerId, true)],
  });
}

async function handleDice(interaction) {
  const sides = interaction.options.getInteger('mat') || 6;
  const amount = interaction.options.getInteger('so_luong') || 1;
  const rolls = Array.from({ length: amount }, () => Math.floor(Math.random() * sides) + 1);
  const total = rolls.reduce((sum, value) => sum + value, 0);

  const embed = new EmbedBuilder()
    .setTitle('🎲 Kết quả tung xúc xắc')
    .setDescription(rolls.map((value, index) => `Viên ${index + 1}: **${value}**`).join('\n'))
    .addFields({ name: 'Tổng', value: `**${total}**`, inline: true })
    .setFooter({ text: `${amount} viên • ${sides} mặt` });

  await interaction.reply({ embeds: [embed] });
}

function createCaroGameId() {
  return randomBytes(5).toString('hex');
}

function caroWinner(board) {
  const winningLines = [
    [0, 1, 2],
    [3, 4, 5],
    [6, 7, 8],
    [0, 3, 6],
    [1, 4, 7],
    [2, 5, 8],
    [0, 4, 8],
    [2, 4, 6],
  ];

  for (const [a, b, c] of winningLines) {
    if (board[a] && board[a] === board[b] && board[a] === board[c]) {
      return board[a];
    }
  }
  return null;
}

function caroRows(game, forceDisabled = false) {
  const rows = [];

  for (let rowIndex = 0; rowIndex < 3; rowIndex += 1) {
    const row = new ActionRowBuilder();
    for (let columnIndex = 0; columnIndex < 3; columnIndex += 1) {
      const cell = rowIndex * 3 + columnIndex;
      const mark = game.board[cell];
      row.addComponents(
        new ButtonBuilder()
          .setCustomId(`caro_move:${game.id}:${cell}`)
          .setLabel(mark || '·')
          .setStyle(
            mark === 'X'
              ? ButtonStyle.Danger
              : mark === 'O'
                ? ButtonStyle.Primary
                : ButtonStyle.Secondary,
          )
          .setDisabled(forceDisabled || Boolean(mark)),
      );
    }
    rows.push(row);
  }

  return rows;
}

function caroEmbed(game, statusText = '') {
  return new EmbedBuilder()
    .setTitle('⭕ Cờ caro 3×3 ❌')
    .setDescription(
      [
        `<@${game.challengerId}>: **X**`,
        `<@${game.opponentId}>: **O**`,
        statusText || `Lượt hiện tại: <@${game.turnId}>`,
      ].join('\n'),
    )
    .setFooter({ text: 'Ba ô liên tiếp theo hàng, cột hoặc đường chéo sẽ thắng.' });
}

function releaseCaroGame(game) {
  caroGames.delete(game.id);
  playerCaroGame.delete(playerGameKey(game.guildId, game.challengerId));
  playerCaroGame.delete(playerGameKey(game.guildId, game.opponentId));
}

async function handleCaroCommand(interaction) {
  if (!interaction.guildId) {
    await ephemeral(interaction, 'Cờ caro chỉ dùng được trong server Discord.');
    return;
  }

  const opponent = interaction.options.getUser('doi_thu', true);
  const challenger = interaction.user;

  if (opponent.bot) {
    await ephemeral(interaction, 'Bạn không thể thách đấu một tài khoản bot.');
    return;
  }

  if (opponent.id === challenger.id) {
    await ephemeral(interaction, 'Bạn không thể tự thách đấu chính mình.');
    return;
  }

  const challengerKey = playerGameKey(interaction.guildId, challenger.id);
  const opponentKey = playerGameKey(interaction.guildId, opponent.id);

  if (playerCaroGame.has(challengerKey)) {
    await ephemeral(interaction, 'Bạn đang có một ván caro chưa kết thúc.');
    return;
  }

  if (playerCaroGame.has(opponentKey)) {
    await ephemeral(interaction, 'Đối thủ đang có một ván caro chưa kết thúc.');
    return;
  }

  const id = createCaroGameId();
  const game = {
    id,
    guildId: interaction.guildId,
    channelId: interaction.channelId,
    messageId: null,
    challengerId: challenger.id,
    opponentId: opponent.id,
    board: Array(9).fill(null),
    turnId: challenger.id,
    status: 'pending',
    createdAt: Date.now(),
    updatedAt: Date.now(),
  };

  caroGames.set(id, game);
  playerCaroGame.set(challengerKey, id);
  playerCaroGame.set(opponentKey, id);

  const row = new ActionRowBuilder().addComponents(
    new ButtonBuilder()
      .setCustomId(`caro_accept:${id}`)
      .setLabel('Chấp nhận')
      .setStyle(ButtonStyle.Success),
    new ButtonBuilder()
      .setCustomId(`caro_decline:${id}`)
      .setLabel('Từ chối / Hủy')
      .setStyle(ButtonStyle.Danger),
  );

  await interaction.reply({
    content: `🎮 <@${opponent.id}>, bạn nhận được lời thách đấu caro từ <@${challenger.id}>!`,
    components: [row],
    allowedMentions: { users: [opponent.id, challenger.id] },
  });

  const message = await interaction.fetchReply();
  game.messageId = message.id;
}

async function handleCaroAccept(interaction, gameId) {
  const game = caroGames.get(gameId);
  if (!game || game.status !== 'pending') {
    await ephemeral(interaction, 'Lời thách đấu này đã hết hạn hoặc không còn tồn tại.');
    return;
  }

  if (interaction.user.id !== game.opponentId) {
    await ephemeral(interaction, 'Chỉ người được thách đấu mới có thể chấp nhận.');
    return;
  }

  game.status = 'active';
  game.updatedAt = Date.now();

  await interaction.update({
    content: 'Ván đấu đã bắt đầu!',
    embeds: [caroEmbed(game)],
    components: caroRows(game),
    allowedMentions: { users: [game.challengerId, game.opponentId] },
  });
}

async function handleCaroDecline(interaction, gameId) {
  const game = caroGames.get(gameId);
  if (!game || game.status !== 'pending') {
    await ephemeral(interaction, 'Lời thách đấu này đã hết hạn hoặc không còn tồn tại.');
    return;
  }

  if (![game.challengerId, game.opponentId].includes(interaction.user.id)) {
    await ephemeral(interaction, 'Bạn không thuộc lời thách đấu này.');
    return;
  }

  releaseCaroGame(game);
  const text =
    interaction.user.id === game.challengerId
      ? '🚫 Người thách đấu đã hủy ván.'
      : '🚫 Đối thủ đã từ chối lời thách đấu.';

  await interaction.update({ content: text, embeds: [], components: [] });
}

async function handleCaroMove(interaction, gameId, cellText) {
  const game = caroGames.get(gameId);
  const cell = Number(cellText);

  if (!game || game.status !== 'active') {
    await ephemeral(interaction, 'Ván caro này đã kết thúc hoặc hết hạn.');
    return;
  }

  if (![game.challengerId, game.opponentId].includes(interaction.user.id)) {
    await ephemeral(interaction, 'Bạn không phải người chơi trong ván này.');
    return;
  }

  if (interaction.user.id !== game.turnId) {
    await ephemeral(interaction, 'Chưa đến lượt của bạn.');
    return;
  }

  if (!Number.isInteger(cell) || cell < 0 || cell > 8 || game.board[cell]) {
    await ephemeral(interaction, 'Ô này không hợp lệ hoặc đã được đánh.');
    return;
  }

  const mark = interaction.user.id === game.challengerId ? 'X' : 'O';
  game.board[cell] = mark;
  game.updatedAt = Date.now();

  const winnerMark = caroWinner(game.board);
  if (winnerMark) {
    const winnerId = winnerMark === 'X' ? game.challengerId : game.opponentId;
    const loserId = winnerId === game.challengerId ? game.opponentId : game.challengerId;

    await Promise.all([
      addReward(game.guildId, winnerId, { xp: 50, coins: 30, games: 1, wins: 1 }),
      addReward(game.guildId, loserId, { xp: 8, games: 1 }),
    ]);

    releaseCaroGame(game);
    await interaction.update({
      content: `🏆 <@${winnerId}> thắng và nhận **50 XP + 30 xu**!`,
      embeds: [caroEmbed(game, `Người thắng: <@${winnerId}>`)],
      components: caroRows(game, true),
      allowedMentions: { users: [winnerId] },
    });
    return;
  }

  if (game.board.every(Boolean)) {
    await Promise.all([
      addReward(game.guildId, game.challengerId, { xp: 15, coins: 8, games: 1 }),
      addReward(game.guildId, game.opponentId, { xp: 15, coins: 8, games: 1 }),
    ]);

    releaseCaroGame(game);
    await interaction.update({
      content: '🤝 Ván đấu hòa! Mỗi người nhận **15 XP + 8 xu**.',
      embeds: [caroEmbed(game, 'Kết quả: Hòa')],
      components: caroRows(game, true),
    });
    return;
  }

  game.turnId =
    game.turnId === game.challengerId ? game.opponentId : game.challengerId;

  await interaction.update({
    content: `Đến lượt <@${game.turnId}>.`,
    embeds: [caroEmbed(game)],
    components: caroRows(game),
    allowedMentions: { users: [game.turnId] },
  });
}

async function handleProfile(interaction) {
  const target = interaction.options.getUser('thanh_vien') || interaction.user;
  const profile = getProfile(guildKey(interaction), target.id);
  const level = levelFromXp(profile.xp);
  const winRate = profile.games > 0 ? Math.round((profile.wins / profile.games) * 100) : 0;

  const embed = new EmbedBuilder()
    .setTitle(`🎮 Hồ sơ của ${target.displayName}`)
    .setThumbnail(target.displayAvatarURL())
    .addFields(
      { name: 'Cấp', value: String(level), inline: true },
      { name: 'XP', value: String(profile.xp), inline: true },
      { name: 'Xu', value: String(profile.coins), inline: true },
      { name: 'Số ván', value: String(profile.games), inline: true },
      { name: 'Số trận thắng', value: String(profile.wins), inline: true },
      { name: 'Tỷ lệ thắng', value: `${winRate}%`, inline: true },
      { name: 'Quiz đúng', value: String(profile.quizCorrect), inline: true },
    );

  await interaction.reply({ embeds: [embed] });
}

async function handleTop(interaction) {
  const leaderboard = getLeaderboard(guildKey(interaction), 10);

  if (leaderboard.length === 0) {
    await interaction.reply('Chưa có dữ liệu xếp hạng. Hãy chơi một trò trước!');
    return;
  }

  const medals = ['🥇', '🥈', '🥉'];
  const users = await Promise.all(
    leaderboard.map(async (entry) => {
      const user = await client.users.fetch(entry.userId).catch(() => null);
      return { ...entry, name: user?.displayName || `User ${entry.userId}` };
    }),
  );

  const lines = users.map((entry, index) => {
    const rank = medals[index] || `**${index + 1}.**`;
    return `${rank} **${entry.name}** — ${entry.xp} XP • ${entry.coins} xu`;
  });

  const embed = new EmbedBuilder()
    .setTitle('🏆 Bảng xếp hạng XP')
    .setDescription(lines.join('\n'))
    .setFooter({ text: 'Bảng xếp hạng riêng của server này.' });

  await interaction.reply({ embeds: [embed] });
}

async function handleCommand(interaction) {
  switch (interaction.commandName) {
    case 'help':
      await interaction.reply({ embeds: [helpEmbed()] });
      break;
    case 'ping':
      await interaction.reply(
        `🏓 Pong! Gateway: **${Math.max(0, client.ws.ping)} ms** • Uptime: **${Math.floor(
          process.uptime(),
        )} giây**`,
      );
      break;
    case 'rps':
      await handleRps(interaction);
      break;
    case 'guess':
      await handleGuess(interaction);
      break;
    case 'quiz':
      await handleQuizCommand(interaction);
      break;
    case 'dice':
      await handleDice(interaction);
      break;
    case 'caro':
      await handleCaroCommand(interaction);
      break;
    case 'profile':
      await handleProfile(interaction);
      break;
    case 'top':
      await handleTop(interaction);
      break;
    default:
      await ephemeral(interaction, 'Lệnh chưa được hỗ trợ.');
  }
}

async function handleButton(interaction) {
  const parts = interaction.customId.split(':');
  const action = parts[0];

  if (action === 'quiz') {
    await handleQuizButton(interaction, parts);
    return;
  }

  if (action === 'caro_accept') {
    await handleCaroAccept(interaction, parts[1]);
    return;
  }

  if (action === 'caro_decline') {
    await handleCaroDecline(interaction, parts[1]);
    return;
  }

  if (action === 'caro_move') {
    await handleCaroMove(interaction, parts[1], parts[2]);
  }
}

async function expireOldCaroGames() {
  const now = Date.now();

  for (const game of caroGames.values()) {
    const maxAge = game.status === 'pending' ? 2 * 60_000 : 15 * 60_000;
    if (now - game.updatedAt < maxAge) continue;

    releaseCaroGame(game);

    if (!game.messageId || !game.channelId) continue;

    try {
      const channel = await client.channels.fetch(game.channelId);
      if (!channel?.isTextBased()) continue;
      const message = await channel.messages.fetch(game.messageId);
      await message.edit({
        content: '⏱️ Ván caro đã tự kết thúc vì hết thời gian.',
        components: game.status === 'active' ? caroRows(game, true) : [],
      });
    } catch (error) {
      console.warn(`[CARO] Không cập nhật được ván hết hạn ${game.id}:`, error.message);
    }
  }
}

client.once(Events.ClientReady, (readyClient) => {
  botReady = true;
  readyClient.user.setPresence({
    activities: [{ name: '/help | Trò chơi', type: ActivityType.Playing }],
    status: 'online',
  });

  cleanupTimer = setInterval(() => {
    expireOldCaroGames().catch((error) => console.error('[CARO CLEANUP]', error));
  }, 60_000);
  cleanupTimer.unref();

  console.log(`[BOT] Đã đăng nhập: ${readyClient.user.tag}`);
});

client.on(Events.InteractionCreate, async (interaction) => {
  try {
    if (interaction.isChatInputCommand()) {
      await handleCommand(interaction);
      return;
    }

    if (interaction.isButton()) {
      await handleButton(interaction);
    }
  } catch (error) {
    console.error('[INTERACTION ERROR]', error);
    if (interaction.isRepliable()) {
      await ephemeral(interaction, 'Đã xảy ra lỗi khi xử lý thao tác. Vui lòng thử lại.').catch(
        () => undefined,
      );
    }
  }
});

client.on(Events.Error, (error) => {
  console.error('[DISCORD CLIENT ERROR]', error);
});

let shuttingDown = false;
async function shutdown(signal) {
  if (shuttingDown) return;
  shuttingDown = true;
  botReady = false;
  console.log(`[SYSTEM] Nhận ${signal}, đang dừng an toàn...`);

  if (cleanupTimer) clearInterval(cleanupTimer);
  await flushStore().catch((error) => console.error('[STORE FLUSH]', error));
  client.destroy();
  healthServer.close(() => process.exit(0));

  setTimeout(() => process.exit(0), 5_000).unref();
}

process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));

process.on('unhandledRejection', (error) => {
  console.error('[UNHANDLED REJECTION]', error);
});

process.on('uncaughtException', (error) => {
  console.error('[UNCAUGHT EXCEPTION]', error);
});

async function main() {
  await initStore();

  healthServer.listen(PORT, '0.0.0.0', () => {
    console.log(`[HTTP] Health server đang nghe tại cổng ${PORT}.`);
  });

  // Đăng nhập trước để bot vẫn có thể online ngay cả khi GUILD_ID hoặc
  // việc đăng ký slash command gặp lỗi tạm thời.
  await client.login(TOKEN);

  try {
    await registerCommands();
  } catch (error) {
    console.error('[COMMANDS ERROR] Bot đã online nhưng chưa đăng ký được slash commands:', error);
  }
}

main().catch((error) => {
  console.error('[STARTUP ERROR]', error);
  process.exit(1);
});
